// Generated by CMake from NanoOcp1Demo.rc.in -- do not edit directly.
// Embeds Windows VERSIONINFO so NanoOcp1Demo.exe's file properties (right-click
// -> Properties -> Details) show the project version. macOS/Linux have no
// equivalent OS-native binary version stamp for a plain CLI executable; there,
// `NanoOcp1Demo --version` and the release archive filename are the version
// vehicles instead.

#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Christian Ahrens"
            VALUE "FileDescription",  "NanoOcp1Demo -- NanoOcp1 CLI demo tool"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "NanoOcp1Demo"
            VALUE "LegalCopyright",   "Copyright (c) 2022-2026, Christian Ahrens"
            VALUE "OriginalFilename", "NanoOcp1Demo.exe"
            VALUE "ProductName",      "NanoOcp1"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
