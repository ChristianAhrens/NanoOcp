// project(NanoOcp1 VERSION ...) call.

#define NANOOCP1_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define NANOOCP1_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define NANOOCP1_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define NANOOCP1_VERSION_STRING "@PROJECT_VERSION@"

namespace NanoOcp1
{

